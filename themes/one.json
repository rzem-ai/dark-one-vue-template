{
  "name": "one",
  "source": [
    "https://github.com/atom/one-dark-syntax (styles/colors.less) and https://github.com/atom/one-dark-ui (styles/ui-variables.less)",
    "https://github.com/atom/one-light-syntax (styles/colors.less) and https://github.com/atom/one-light-ui (styles/ui-variables.less)"
  ],
  "notes": [
    "chart-1..5 follow Atom's hue-1..5 in order: cyan, blue, purple, green, red.",
    "Dark muted-foreground is mono-2 rather than the comment grey (#5c6370), which is 2.3:1 on the background and unreadable as helper text.",
    "Dark border is the selection grey rather than Atom's #181a1f panel divider, which is darker than the surface and vanishes on card outlines.",
    "radius stays shadcn's 0.625rem; the components are still shadcn, the skin is the colour."
  ],
  "cssVarsV4": {
    "light": {
      "background": "#fafafa",
      "foreground": "#383a42",
      "card": "#ffffff",
      "card-foreground": "#383a42",
      "popover": "#ffffff",
      "popover-foreground": "#383a42",
      "primary": "#4078f2",
      "primary-foreground": "#ffffff",
      "secondary": "#e5e5e6",
      "secondary-foreground": "#383a42",
      "muted": "#f0f0f1",
      "muted-foreground": "#696c77",
      "accent": "#e5e5e6",
      "accent-foreground": "#383a42",
      "destructive": "#e45649",
      "border": "#dbdbdc",
      "input": "#dbdbdc",
      "ring": "#526fff",
      "chart-1": "#0184bc",
      "chart-2": "#4078f2",
      "chart-3": "#a626a4",
      "chart-4": "#50a14f",
      "chart-5": "#e45649",
      "radius": "0.625rem",
      "sidebar": "#eaeaeb",
      "sidebar-foreground": "#383a42",
      "sidebar-primary": "#4078f2",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#e5e5e6",
      "sidebar-accent-foreground": "#383a42",
      "sidebar-border": "#dbdbdc",
      "sidebar-ring": "#526fff"
    },
    "dark": {
